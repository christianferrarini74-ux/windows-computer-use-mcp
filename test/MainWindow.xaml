<Window x:Class="WindowsComputerUse.TestBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Windows Computer Use Test Bench"
        Width="1040" Height="800" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Windows Computer Use Test Bench" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="A disposable UI for observing and exercising the MCP tools." Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>

        <Border Grid.Row="1" Padding="10" Margin="0,0,0,14" Background="#EAF2FA" CornerRadius="4">
            <TextBlock x:Name="StatusText"
                       automation:AutomationProperties.AutomationId="testStatus"
                       automation:AutomationProperties.Name="Test status"
                       Text="Ready — reset returns every control to this state."
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="Text and keyboard" Margin="0,0,0,12">
                        <StackPanel Margin="10">
                            <TextBlock Text="Enter text, then use Apply (or Ctrl+Enter)." Margin="0,0,0,6" />
                            <TextBox x:Name="InputTextBox"
                                     automation:AutomationProperties.AutomationId="inputTextBox"
                                     automation:AutomationProperties.Name="Text to apply"
                                     Text="Computer Use test text"
                                     MinHeight="30" Padding="6" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ApplyButton"
                                        automation:AutomationProperties.AutomationId="applyButton"
                                        Content="Apply text" MinWidth="110" Padding="10,5" Click="ApplyButton_Click" />
                                <Button x:Name="ResetButton"
                                        automation:AutomationProperties.AutomationId="resetButton"
                                        Content="Reset all" MinWidth="100" Padding="10,5" Margin="8,0,0,0" Click="ResetButton_Click" />
                            </WrapPanel>
                            <TextBlock Text="Applied value" Margin="0,10,0,4" FontWeight="SemiBold" />
                            <TextBox x:Name="OutputTextBox"
                                     automation:AutomationProperties.AutomationId="outputTextBox"
                                     automation:AutomationProperties.Name="Applied value"
                                     IsReadOnly="True" MinHeight="30" Padding="6" Text="(nothing applied yet)" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="UI Automation patterns" Margin="0,0,0,12">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="TestCheckBox"
                                      automation:AutomationProperties.AutomationId="testCheckBox"
                                      Content="Toggle this option"
                                      Margin="0,0,0,10"
                                      Checked="TestCheckBox_Changed" Unchecked="TestCheckBox_Changed" />
                            <TextBlock Text="Select an item" Margin="0,0,0,4" />
                            <ComboBox x:Name="TestComboBox"
                                      automation:AutomationProperties.AutomationId="testComboBox"
                                      automation:AutomationProperties.Name="Test choices"
                                      SelectionChanged="TestComboBox_SelectionChanged">
                                <ComboBoxItem Content="Alpha" />
                                <ComboBoxItem Content="Bravo" />
                                <ComboBoxItem Content="Charlie" />
                            </ComboBox>
                            <TextBlock Text="Choose a row" Margin="0,10,0,4" />
                            <ListBox x:Name="TestListBox"
                                     automation:AutomationProperties.AutomationId="testListBox"
                                     automation:AutomationProperties.Name="Test rows"
                                     Height="105" SelectionChanged="TestListBox_SelectionChanged">
                                <ListBoxItem Content="Row one" />
                                <ListBoxItem Content="Row two" />
                                <ListBoxItem Content="Row three" />
                            </ListBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Expand, drag and scroll" Margin="0,0,0,12">
                        <StackPanel Margin="10">
                            <Expander x:Name="TestExpander"
                                      automation:AutomationProperties.AutomationId="testExpander"
                                      Header="Expand this section"
                                      Expanded="TestExpander_Changed" Collapsed="TestExpander_Changed">
                                <TextBlock automation:AutomationProperties.AutomationId="expandedContent"
                                           Text="Expanded content is available." Margin="8" />
                            </Expander>
                            <TextBlock Text="Drag the slider or set it with UIA." Margin="0,10,0,0" />
                            <Slider x:Name="TestSlider"
                                    automation:AutomationProperties.AutomationId="testSlider"
                                    automation:AutomationProperties.Name="Test slider"
                                    Minimum="0" Maximum="100" Value="50" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="TestSlider_ValueChanged" />
                            <TextBlock x:Name="SliderValueText" Text="Slider value: 50" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Dynamic UIA element and wait" Margin="0,0,0,12">
                        <StackPanel Margin="10">
                            <TextBlock Text="Create a control, then wait for AutomationId dynamicActionButton." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button x:Name="CreateDynamicButton"
                                    automation:AutomationProperties.AutomationId="createDynamicButton"
                                    Content="Create dynamic control" Padding="10,5" HorizontalAlignment="Left" Click="CreateDynamicButton_Click" />
                            <StackPanel x:Name="DynamicItemsPanel" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GroupBox Grid.Column="2" Header="Modal window and scroll target">
                <DockPanel Margin="10">
                    <Button x:Name="OpenDialogButton"
                            automation:AutomationProperties.AutomationId="openDialogButton"
                            Content="Open modal dialog" Padding="10,6" HorizontalAlignment="Left"
                            DockPanel.Dock="Top" Click="OpenDialogButton_Click" />
                    <TextBlock Text="Open the dialog, inspect it, then close it with its button or Escape." TextWrapping="Wrap" Margin="0,8,0,12" DockPanel.Dock="Top" />
                    <ScrollViewer x:Name="TestScrollViewer"
                                  automation:AutomationProperties.AutomationId="testScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ScrollItemsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#666"
                   Text="Tip: the app is safe to reset. No user files are opened or modified." />
    </Grid>
</Window>
