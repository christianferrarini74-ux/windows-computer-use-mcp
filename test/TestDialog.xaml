<Window x:Class="WindowsComputerUse.TestBench.TestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Computer Use Test Dialog"
        Width="420" Height="230" MinWidth="360" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock automation:AutomationProperties.AutomationId="dialogMessage"
                       Text="Modal dialog is open. This is a separate window for wait and window targeting tests."
                       TextWrapping="Wrap" FontSize="16" />
        </StackPanel>
        <Button Grid.Row="1"
                automation:AutomationProperties.AutomationId="closeDialogButton"
                Content="Close dialog" Padding="12,6" HorizontalAlignment="Right"
                IsDefault="True" Click="CloseButton_Click" />
    </Grid>
</Window>
